      "smoke": {"clean": {"seed_family": "e1-v2-smoke-clean-v2", "start": 440000, "count": 8}, "nuisance": {"seed_family": "e1-v2-smoke-nuisance-v2", "start": 450000, "count": 12}, "defect": {"seed_family": "e1-v2-smoke-defect-v2", "start": 460000, "count": 24}, "trust_boundary": {"seed_family": "e1-v2-smoke-trust-v2", "start": 470000, "count": 4}},
      "calibration": {"clean": {"seed_family": "e1-v2-calibration-clean-v2", "start": 500000, "count": 24}, "nuisance": {"seed_family": "e1-v2-calibration-nuisance-v2", "start": 510000, "count": 30}, "defect": {"seed_family": "e1-v2-calibration-defect-v2", "start": 520000, "count": 60}, "trust_boundary": {"seed_family": "e1-v2-calibration-trust-v2", "start": 530000, "count": 6}},
      "release_test": {"clean": {"seed_family": "e1-v2-release-test-clean-v2", "start": 700000, "count": 48}, "nuisance": {"seed_family": "e1-v2-release-test-nuisance-v2", "start": 710000, "count": 60}, "defect": {"seed_family": "e1-v2-release-test-defect-v2", "start": 720000, "count": 120}, "trust_boundary": {"seed_family": "e1-v2-release-test-trust-v2", "start": 730000, "count": 12}}
    }
  },
  "scopes": {
    "development": {"clean": 24, "nuisance": 30, "defect": 60, "trust_boundary": 6, "case_count": 120},
    "smoke": {"clean": 8, "nuisance": 12, "defect": 24, "trust_boundary": 4, "case_count": 48},
    "calibration": {"clean": 24, "nuisance": 30, "defect": 60, "trust_boundary": 6, "case_count": 120},
    "release_test": {"clean": 48, "nuisance": 60, "defect": 120, "trust_boundary": 12, "case_count": 240}
