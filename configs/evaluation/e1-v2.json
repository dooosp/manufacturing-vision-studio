  "threshold_selection": {"locked_image_threshold": 0.0025},
  "acceptance_gates": [
    {"gate_id": "medium_high_defect_recall", "operator": "gte", "threshold": 0.9},
    {"gate_id": "nuisance_only_false_positive_rate", "operator": "lte", "threshold": 0.05},
    {"gate_id": "positive_case_median_dice", "operator": "gte", "threshold": 0.7},
    {"gate_id": "affected_feature_mapping_accuracy", "operator": "gte", "threshold": 0.95},
    {"gate_id": "revision_mismatch_publication_count", "operator": "eq", "threshold": 0},
    {"gate_id": "corrupted_evidence_publication_count", "operator": "eq", "threshold": 0},
    {"gate_id": "bundle_verify_reimport_rate", "operator": "gte", "threshold": 1.0},
    {"gate_id": "dataset_split_hash_overlap", "operator": "eq", "threshold": 0},
    {"gate_id": "same_seed_manifest_equivalence", "operator": "is_true", "threshold": true},
    {"gate_id": "v0_1_regression", "operator": "is_true", "threshold": true}
  ]
