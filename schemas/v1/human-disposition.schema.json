{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.manufacturing-vision-studio.local/v1/human-disposition.schema.json",
  "title": "Manufacturing Vision Studio human disposition v1",
  "description": "Immutable, revision-bound human review decision for one analysis result. This is not a cryptographic signature or production release authorization.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "disposition_id",
    "disposition_revision",
    "case_id",
    "case_revision",
    "part_identity",
    "analysis_binding",
    "decision",
    "reviewer",
    "reason_codes",
    "rationale",
    "recorded_at",
    "supersedes_disposition_id",
    "scope_acknowledgement"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "disposition_id": {
      "$ref": "#/$defs/identifier"
    },
    "disposition_revision": {
      "type": "integer",
      "minimum": 1
    },
    "case_id": {
      "$ref": "#/$defs/identifier"
    },
    "case_revision": {
      "type": "integer",
      "minimum": 1
    },
    "part_identity": {
      "$ref": "#/$defs/part_identity"
    },
    "analysis_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "analysis_id",
        "analysis_result_sha256",
        "inspection_image_id",
        "inspection_image_sha256"
      ],
      "properties": {
        "analysis_id": {
          "$ref": "#/$defs/identifier"
        },
        "analysis_result_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "inspection_image_id": {
          "$ref": "#/$defs/identifier"
        },
        "inspection_image_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "decision": {
      "enum": [
        "accept",
        "reject",
        "needs_review",
        "model_error"
      ]
    },
    "reviewer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reviewer_id"
      ],
      "properties": {
        "reviewer_id": {
          "$ref": "#/$defs/identifier"
        },
        "display_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "reason_codes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "enum": [
          "visual_confirmation",
          "score_below_threshold",
          "score_above_threshold",
          "critical_feature_affected",
          "insufficient_evidence",
          "incorrect_mask",
          "incorrect_feature_mapping",
          "incorrect_classification",
          "other"
        ]
      }
    },
    "rationale": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time"
    },
    "supersedes_disposition_id": {
      "oneOf": [
        {
          "$ref": "#/$defs/identifier"
        },
        {
          "type": "null"
        }
      ]
    },
    "scope_acknowledgement": {
      "const": "demo_only_not_production_validated"
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "part_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "part_id",
        "cad_revision"
      ],
      "properties": {
        "part_id": {
          "$ref": "#/$defs/identifier"
        },
        "cad_revision": {
          "$ref": "#/$defs/identifier"
        }
      }
    }
  }
}
