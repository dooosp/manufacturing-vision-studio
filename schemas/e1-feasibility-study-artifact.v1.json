{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://manufacturing-vision-studio.local/schemas/e1-feasibility-study-artifact.v1.json",
  "$ref": "#/$defs/phaseExecutionClaim",
  "$defs": {
    "sha1": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "phase1Payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phase",
        "expected_members",
        "expected_modes",
        "expected_mode_count",
        "expected_inference_rows_per_mode",
        "trust_binding_rows"
      ],
      "properties": {
        "phase": {
          "const": "phase1"
        },
        "expected_members": {
          "const": 108
        },
        "expected_modes": {
          "const": [
            "NEAREST",
            "BILINEAR",
            "BICUBIC"
          ]
        },
        "expected_mode_count": {
          "const": 3
        },
        "expected_inference_rows_per_mode": {
          "const": 108
        },
        "trust_binding_rows": {
          "const": 0
        }
      }
    },
    "phase2Payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phase",
        "expected_members",
        "expected_modes",
        "expected_mode_count",
        "expected_inference_rows_per_mode",
        "trust_binding_rows"
      ],
      "properties": {
        "phase": {
          "const": "phase2"
        },
        "expected_members": {
          "const": 120
        },
        "expected_modes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "enum": [
              "NEAREST",
              "BILINEAR",
              "BICUBIC"
            ]
          }
        },
        "expected_mode_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "expected_inference_rows_per_mode": {
          "const": 114
        },
        "trust_binding_rows": {
          "const": 6
        }
      }
    },
    "phaseExecutionClaim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_type",
        "schema_version",
        "study_id",
        "development_only",
        "selection_eligible",
        "release_claim_allowed",
        "base_commit",
        "execution_commit",
        "protocol_sha256",
        "artifact_root",
        "payload",
        "record_sha256"
      ],
      "properties": {
        "record_type": {
          "const": "phase_execution_claim"
        },
        "schema_version": {
          "const": "1.0.0"
        },
        "study_id": {
          "const": "e1-feasibility-separability"
        },
        "development_only": {
          "const": true
        },
        "selection_eligible": {
          "const": false
        },
        "release_claim_allowed": {
          "const": false
        },
        "base_commit": {
          "$ref": "#/$defs/sha1"
        },
        "execution_commit": {
          "$ref": "#/$defs/sha1"
        },
        "protocol_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "artifact_root": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "payload": {
          "oneOf": [
            {
              "$ref": "#/$defs/phase1Payload"
            },
            {
              "$ref": "#/$defs/phase2Payload"
            }
          ]
        },
        "record_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    }
  }
}
