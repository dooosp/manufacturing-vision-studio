{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.manufacturing-vision-studio.local/e1-case-manifest.v1.json",
  "title": "Manufacturing Vision Studio E1 case manifest v1",
  "description": "Canonical mini or full E1 case manifest with generator, source, oracle, and case-binding hashes.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "manifest_id",
    "protocol",
    "generator",
    "profile",
    "counts",
    "cases",
    "manifest_sha256"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "manifest_id": {"$ref": "#/$defs/identifier"},
    "protocol": {"$ref": "#/$defs/protocol_binding"},
    "generator": {"$ref": "#/$defs/generator_binding"},
    "profile": {"enum": ["mini", "full"]},
    "counts": {"$ref": "#/$defs/counts"},
    "cases": {
      "type": "array",
      "minItems": 48,
      "maxItems": 480,
      "items": {"$ref": "#/$defs/case"}
    },
    "manifest_sha256": {"$ref": "#/$defs/sha256"}
  },
  "allOf": [
    {
      "if": {"properties": {"profile": {"const": "mini"}}, "required": ["profile"]},
      "then": {
        "properties": {
          "counts": {
            "allOf": [
              {"$ref": "#/$defs/counts"},
              {
                "properties": {
                  "case_count": {"const": 48},
                  "inference_case_count": {"const": 44},
                  "trust_case_count": {"const": 4},
                  "group_counts": {
                    "const": {"clean": 8, "nuisance": 12, "defect": 24, "trust_boundary": 4}
                  }
                }
              }
            ]
          },
          "cases": {"minItems": 48, "maxItems": 48}
        }
      }
    },
    {
      "if": {"properties": {"profile": {"const": "full"}}, "required": ["profile"]},
      "then": {
        "properties": {
          "counts": {
            "allOf": [
              {"$ref": "#/$defs/counts"},
              {
                "properties": {
                  "case_count": {"const": 480},
                  "inference_case_count": {"const": 456},
                  "trust_case_count": {"const": 24},
                  "group_counts": {
                    "const": {"clean": 96, "nuisance": 120, "defect": 240, "trust_boundary": 24}
                  }
                }
              }
            ]
          },
          "cases": {"minItems": 480, "maxItems": 480}
        }
      }
    }
  ],
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "recipe_id": {
      "type": "string",
      "maxLength": 192,
      "pattern": "^mvs-e1-recipe-v1/e1-(development|calibration|test)-(clean|nuisance|defect|trust_boundary)-[0-9]{3}$"
    },
    "semantic_version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
      "maxLength": 32
    },
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "count": {"type": "integer", "minimum": 0, "maximum": 1000000},
    "protocol_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol_id", "protocol_version", "protocol_sha256"],
      "properties": {
        "protocol_id": {"const": "mvs-e1"},
        "protocol_version": {"const": "1.3.0"},
        "protocol_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "generator_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["generator_id", "generator_version", "generator_configuration_sha256"],
      "properties": {
        "generator_id": {"const": "mvs-e1-generator"},
        "generator_version": {"const": "1.0.0"},
        "generator_configuration_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "group_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["clean", "nuisance", "defect", "trust_boundary"],
      "properties": {
        "clean": {"$ref": "#/$defs/count"},
        "nuisance": {"$ref": "#/$defs/count"},
        "defect": {"$ref": "#/$defs/count"},
        "trust_boundary": {"$ref": "#/$defs/count"}
      }
    },
    "split_count": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_count", "group_counts"],
      "properties": {
        "case_count": {"$ref": "#/$defs/count"},
        "group_counts": {"$ref": "#/$defs/group_counts"}
      }
    },
    "split_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["development", "calibration", "test"],
      "properties": {
        "development": {"$ref": "#/$defs/split_count"},
        "calibration": {"$ref": "#/$defs/split_count"},
        "test": {"$ref": "#/$defs/split_count"}
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_count",
        "inference_case_count",
        "trust_case_count",
        "group_counts",
        "split_counts"
      ],
      "properties": {
        "case_count": {"type": "integer", "minimum": 48, "maximum": 480},
        "inference_case_count": {"type": "integer", "minimum": 44, "maximum": 456},
        "trust_case_count": {"type": "integer", "minimum": 4, "maximum": 24},
        "group_counts": {"$ref": "#/$defs/group_counts"},
        "split_counts": {"$ref": "#/$defs/split_counts"}
      }
    },
    "recipe_parameter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "unit", "value"],
      "properties": {
        "name": {"$ref": "#/$defs/identifier"},
        "unit": {"type": "string", "minLength": 1, "maxLength": 32},
        "value": {"type": "number", "minimum": -1000000, "maximum": 1000000}
      }
    },
    "defect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["defect_id", "type", "severity", "target_feature_id", "parameters"],
      "properties": {
        "defect_id": {"$ref": "#/$defs/identifier"},
        "type": {
          "enum": [
            "scratch",
            "stain",
            "edge_chip",
            "burr",
            "blocked_hole",
            "hole_geometry_deviation"
          ]
        },
        "severity": {"enum": ["LOW", "MEDIUM", "HIGH"]},
        "target_feature_id": {
          "enum": ["top_face", "hole_left", "hole_right", "top_edge", "bottom_edge"]
        },
        "parameters": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "items": {"$ref": "#/$defs/recipe_parameter"}
        }
      }
    },
    "nuisance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "parameters"],
      "properties": {
        "type": {
          "enum": [
            "translation",
            "rotation",
            "scale",
            "exposure",
            "directional_shading",
            "gaussian_blur",
            "sensor_noise",
            "jpeg_compression",
            "background_fixture"
          ]
        },
        "parameters": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {"$ref": "#/$defs/recipe_parameter"}
        }
      }
    },
    "trust_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scenario_id", "expected_error_code", "publication_allowed"],
      "properties": {
        "scenario_id": {"$ref": "#/$defs/identifier"},
        "expected_error_code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Z][A-Z0-9_]{0,63}$"
        },
        "publication_allowed": {"const": false}
      }
    },
    "part_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["part_id", "cad_revision"],
      "properties": {
        "part_id": {"const": "MVS-E1-PLATE-001"},
        "cad_revision": {"enum": ["rev-A", "rev-B"]}
      }
    },
    "source_hashes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reference_sha256",
        "inspection_sha256",
        "authoritative_mask_sha256",
        "case_binding_sha256"
      ],
      "properties": {
        "reference_sha256": {"$ref": "#/$defs/sha256"},
        "inspection_sha256": {"$ref": "#/$defs/sha256"},
        "authoritative_mask_sha256": {"$ref": "#/$defs/sha256"},
        "case_binding_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "profile_membership",
        "split",
        "group",
        "ordinal",
        "seed_family",
        "seed",
        "recipe_id",
        "recipe_version",
        "part_identity",
        "view_id",
        "expected_outcome",
        "support_boundary",
        "defect",
        "nuisance_profile",
        "trust_boundary",
        "generator",
        "source_hashes"
      ],
      "properties": {
        "case_id": {
          "type": "string",
          "pattern": "^e1-(development|calibration|test)-(clean|nuisance|defect|trust_boundary)-[0-9]{3}$",
          "maxLength": 128
        },
        "profile_membership": {
          "oneOf": [
            {"const": ["full"]},
            {"const": ["full", "mini"]}
          ]
        },
        "split": {"enum": ["development", "calibration", "test"]},
        "group": {"enum": ["clean", "nuisance", "defect", "trust_boundary"]},
        "ordinal": {"type": "integer", "minimum": 0, "maximum": 999},
        "seed_family": {"$ref": "#/$defs/identifier"},
        "seed": {"type": "integer", "minimum": 0, "maximum": 4294967295},
        "recipe_id": {"$ref": "#/$defs/recipe_id"},
        "recipe_version": {"const": "1.0.0"},
        "part_identity": {"$ref": "#/$defs/part_identity"},
        "view_id": {"enum": ["front", "oblique_left", "oblique_right"]},
        "expected_outcome": {"enum": ["NORMAL", "ANOMALY", "ABSTAIN"]},
        "support_boundary": {
          "enum": ["SUPPORTED_NORMAL_RANGE", "UNSUPPORTED_OR_ABSTAIN_RANGE"]
        },
        "defect": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/defect"}]},
        "nuisance_profile": {
          "type": "array",
          "maxItems": 1,
          "items": {"$ref": "#/$defs/nuisance"}
        },
        "trust_boundary": {
          "oneOf": [{"type": "null"}, {"$ref": "#/$defs/trust_boundary"}]
        },
        "generator": {"$ref": "#/$defs/generator_binding"},
        "source_hashes": {"$ref": "#/$defs/source_hashes"}
      },
      "allOf": [
        {
          "if": {"properties": {"group": {"const": "clean"}}, "required": ["group"]},
          "then": {
            "properties": {
              "expected_outcome": {"const": "NORMAL"},
              "support_boundary": {"const": "SUPPORTED_NORMAL_RANGE"},
              "defect": {"type": "null"},
              "nuisance_profile": {"maxItems": 0},
              "trust_boundary": {"type": "null"}
            }
          }
        },
        {
          "if": {"properties": {"group": {"const": "nuisance"}}, "required": ["group"]},
          "then": {
            "properties": {
              "expected_outcome": {"const": "NORMAL"},
              "support_boundary": {"const": "SUPPORTED_NORMAL_RANGE"},
              "defect": {"type": "null"},
              "nuisance_profile": {"minItems": 1, "maxItems": 1},
              "trust_boundary": {"type": "null"}
            }
          }
        },
        {
          "if": {"properties": {"group": {"const": "defect"}}, "required": ["group"]},
          "then": {
            "properties": {
              "expected_outcome": {"const": "ANOMALY"},
              "support_boundary": {"const": "SUPPORTED_NORMAL_RANGE"},
              "defect": {"$ref": "#/$defs/defect"},
              "nuisance_profile": {"maxItems": 0},
              "trust_boundary": {"type": "null"}
            }
          }
        },
        {
          "if": {
            "properties": {"group": {"const": "trust_boundary"}},
            "required": ["group"]
          },
          "then": {
            "properties": {
              "expected_outcome": {"const": "ABSTAIN"},
              "support_boundary": {"const": "UNSUPPORTED_OR_ABSTAIN_RANGE"},
              "defect": {"type": "null"},
              "trust_boundary": {"$ref": "#/$defs/trust_boundary"}
            }
          }
        }
      ]
    }
  }
}
